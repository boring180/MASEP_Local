	month = may,
	year = {2025},
	pages = {4138--4144},
	file = {Cai et al. - 2025 - A Data-Driven Velocity Estimator for Autonomous Underwater Vehicles Experiencing Unmeasurable Flow a.pdf:/Users/xuborong/Library/CloudStorage/GoogleDrive-bxu90351@gmail.com/My Drive/Readings/MASEP/Cai et al. - 2025 - A Data-Driven Velocity Estimator for Autonomous Underwater Vehicles Experiencing Unmeasurable Flow a.pdf:application/pdf},
