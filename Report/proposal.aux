\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Three-camera setup used for initial chessboard calibration data collection. Cameras are positioned to capture overlapping views of the calibration pattern from multiple angles, ensuring sufficient geometric diversity for robust intrinsic parameter estimation.}}{12}{}\protected@file@percent }
\newlabel{collection array}{{6}{12}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Chessboard corner detection validation showing successful identification of 8×11 internal corners. The overlaid grid confirms proper pattern recognition, with corner coordinates used for camera calibration parameter estimation.}}{13}{}\protected@file@percent }
\newlabel{validation}{{7}{13}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Synchronized video frames from five cameras showing simultaneous capture of the chessboard pattern. Time synchronization ensures consistent object points across all camera views, enabling accurate extrinsic parameter calibration between camera coordinate systems.}}{13}{}\protected@file@percent }
\newlabel{multi_cameras}{{8}{13}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Visualization of detected chessboard corners with overlaid coordinate axes. The red circles mark detected corner positions used for establishing the world coordinate system and computing camera projection matrices.}}{14}{}\protected@file@percent }
\newlabel{chessboard}{{9}{14}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces ChArUco calibration board with detected corner points marked in green. The embedded ArUco markers enable robust underwater detection even when only partial board segments are visible, overcoming limitations of traditional chessboard patterns in refractive environments.}}{14}{}\protected@file@percent }
\newlabel{ChArUco}{{10}{14}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Comparison of distorted (left) and undistorted (right) images showing barrel distortion correction using intrinsic calibration parameters. The radial distortion coefficients compensate for lens imperfections, ensuring accurate marker detection and pose estimation.}}{15}{}\protected@file@percent }
\newlabel{undistrot}{{11}{15}{Objective Statement 2: Camera Array Calibration}{}{}}
\newlabel{int_param}{{1}{15}{Objective Statement 2: Camera Array Calibration}{}{}}
\newlabel{ext_goal}{{2}{16}{Objective Statement 2: Camera Array Calibration}{}{}}
\newlabel{polynomial}{{3}{16}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Capture of a ChArUco board in the cross section between two cameras.}}{17}{}\protected@file@percent }
\newlabel{charuco_capture}{{12}{17}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces 3D visualization of calibrated camera positions and orientations showing the extrinsic calibration results. The coordinate frames represent each camera's pose relative to the world coordinate system, with transformation matrices enabling consistent multi-camera localization.}}{18}{}\protected@file@percent }
\newlabel{ext_result}{{13}{18}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces Separate K and Distortion Calibration}}{18}{}\protected@file@percent }
\newlabel{alg:distortion_calibration}{{1}{18}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Vector field of the camera distortion.}}{19}{}\protected@file@percent }
\newlabel{distortion_field}{{14}{19}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Comparison of different method of intrinsic calibration with localization error between cameras with groundtruth extrinsic parameter.}}{19}{}\protected@file@percent }
\newlabel{int_results}{{15}{19}{Objective Statement 2: Camera Array Calibration}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces ArUco marker tracking test setup showing marker movement along a linear path. The coordinate axes overlaid on the marker demonstrate successful pose estimation, with position data collected at 0.125m intervals for localization accuracy validation.}}{20}{}\protected@file@percent }
\newlabel{aruco test}{{16}{20}{Objective Statement 3: ArUco Tracking Implementation}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.3}Objective Statement 3: ArUco Tracking Implementation}{20}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Comparison of localization results from multiple cameras viewing the same ArUco marker. The scatter plot shows position estimates in the xy-plane, highlighting inconsistencies between camera coordinate systems before extrinsic calibration and fusion.}}{21}{}\protected@file@percent }
\newlabel{share_local}{{17}{21}{Objective Statement 3: ArUco Tracking Implementation}{}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2.2.4}Objective Statement 4: RSSI localization Implementation}{21}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces ArUco marker trajectory tracking in air showing consistent localization performance. The smooth path (blue line) with minimal scatter demonstrates accurate pose estimation without refractive distortion effects.}}{22}{}\protected@file@percent }
\newlabel{air_tracking}{{18}{22}{Objective Statement 3: ArUco Tracking Implementation}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces ArUco marker trajectory tracking underwater with the same distortion parameter in air. Showing increased localization variability due to refraction effects. The scattered position estimates highlight the need for refraction-corrected calibration parameters and robust multi-camera fusion algorithms.}}{22}{}\protected@file@percent }
\newlabel{water_tracking}{{19}{22}{Objective Statement 3: ArUco Tracking Implementation}{}{}}
